# tbblog Strapi 5. Copy to .env (Strapi reads .env), chmod 600, never commit. Different secrets on every server.
#   Workstation: .env in this folder for npm run develop.
#   Server:      .env.local from the tbown package, passed to the container as env_file.
# Every value is read at run time; nothing here is built into the image (.dockerignore).

# --- Server ---
# 127.0.0.1 on a workstation; 0.0.0.0 in a container
HOST=127.0.0.1
# 1339 so it does not clash with tbbe (1337, 1338)
PORT=1339
# Strapi's own public address (no /api); empty in dev
PUBLIC_URL=
# Browser addresses allowed to call Strapi (comma separated; https://*.example.com allows every sub-domain)
CORS_ORIGINS=http://localhost:*

# --- Strapi secrets (required; each one random, generated once: openssl rand -base64 32) ---
# APP_KEYS = four of them, comma separated
APP_KEYS=CHANGE_ME,CHANGE_ME,CHANGE_ME,CHANGE_ME
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# --- Database: its own database on tbpgdb, never tbbe's "strapi" database (Strapi 5 would migrate it) ---
DATABASE_CLIENT=postgres
# Workstation: 127.0.0.1 / 5433 (the tunnel to tbpgdb). Container on tbnet: tbpgdb / 5432
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=tbblog
DATABASE_USERNAME=tbblog
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false
