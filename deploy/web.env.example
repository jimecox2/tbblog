# web.env.local for the tbblog-web container. chmod 600, never commit. Own secrets on every server.
# The blog's public address
BLOG_URL=https://blog.agile-pm-rm-ppm.com
# (staging on lser: https://blogs.agile-pm-rm-ppm.com and TB_ENVIRONMENT=STAGING)
# openssl rand -base64 32 for each
AUTH_SECRET=CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME
EDITOR_ROLES=Content Editor
# PROD hides the red environment bar
TB_ENVIRONMENT=PROD
BLOG_WWW_URL=https://www.timebars.com
