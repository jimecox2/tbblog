# strapi.env.local for the tbblog-strapi container. chmod 600, never commit. Own secrets on every server.
# Generate each secret with: openssl rand -base64 32 (APP_KEYS = four of them, comma separated)
APP_KEYS=CHANGE_ME,CHANGE_ME,CHANGE_ME,CHANGE_ME
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# tbpgdb on the tbnet network (inside Docker it is always port 5432)
DATABASE_CLIENT=postgres
DATABASE_HOST=tbpgdb
DATABASE_PORT=5432
DATABASE_NAME=tbblog
DATABASE_USERNAME=tbblog
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false

# Strapi's admin address on the LAN, e.g. http://192.168.1.205:1339
PUBLIC_URL=http://192.168.1.205:1339
CORS_ORIGINS=http://localhost:*
