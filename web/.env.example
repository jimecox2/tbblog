# tbblog web (Next.js). Copy to .env.local, chmod 600, never commit.
#   Workstation: .env.local in this folder, for npm run dev (port 3011).
#   Server:      .env.local from the tbown package, passed to the container as env_file.
# Every value is read by the server at run time; nothing is built into the image. Never use a NEXT_PUBLIC_ name.

# Blog Strapi REST API, with /api. Dev: http://localhost:1339/api. Container on tbnet: http://tbblog-strapi:1339/api
STRAPI_URL=http://localhost:1339/api

# This blog's own public address, e.g. https://blog.example.com (http://localhost:3011 in dev)
BLOG_URL=http://localhost:3011

# The Timebars Ltd. website, for the "Visit Timebars Ltd." link. Unset = https://www.timebars.com
BLOG_WWW_URL=

# DEV, STAGING, PROD or TRAINING. Anything but PROD shows a dark red nav bar with the name. Unset = PROD.
TB_ENVIRONMENT=DEV

# Where browsers load images uploaded to Strapi (/uploads/...). Empty = through this site (Strapi stays private).
STRAPI_MEDIA_URL=

# Shared with Strapi's webhook (Settings → Webhooks, header Authorization: Bearer <this>). openssl rand -base64 32
REVALIDATE_SECRET=CHANGE_ME

# --- Editor sign-in (NextAuth) ---
# A long random string: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
# Strapi roles (Users & Permissions) allowed to sign in and edit, comma separated. Unset = Content Editor
EDITOR_ROLES=Content Editor
